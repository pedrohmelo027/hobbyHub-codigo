classDiagram
    direction LR

    class Usuario {
        -id : Long
        -nome : String
        -email : String
        -biografia : String
        -nomeUsuario : String
        -senha : String
        -role : Role
    }

    class Post {
        -id : Long
        -conteudo : String
        -dataCriacao : LocalDateTime
        -urlImagem : String
    }

    class Tag {
        -id : Long
        -nome : String
        -tipo : TipoDeTag
    }

    class Role {
        <<enumeration>>
        USUARIO
        ADMIN
    }

    class TipoDeTag {
        <<enumeration>>
        GERAL
        ESPECIFICA
    }

    Post "0..*" --> "1" Usuario : usuario
    Post "0..*" o--> "2" Tag : tags
    Usuario "0..*" o--> "0..*" Tag : tagsSeguidas
    Tag "0..*" --> "0..1" Tag : tagGeral
    Usuario ..> Role
    Tag ..> TipoDeTag

    note for Post "Uma tag GERAL e uma ESPECIFICA pertencente a ela. urlImagem referencia uma imagem ou video armazenado."
    note for Tag "GERAL: nenhum pai. ESPECIFICA: exatamente um pai do tipo GERAL."
