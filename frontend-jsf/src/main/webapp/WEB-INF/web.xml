<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <display-name>HobbyHub JSF</display-name>
    <listener>
        <listener-class>org.jboss.weld.environment.servlet.Listener</listener-class>
    </listener>
    <context-param>
        <param-name>javax.faces.PROJECT_STAGE</param-name>
        <param-value>Production</param-value>
    </context-param>
    <context-param>
        <param-name>javax.faces.STATE_SAVING_METHOD</param-name>
        <param-value>server</param-value>
    </context-param>
    <context-param>
        <param-name>javax.faces.validator.DISABLE_DEFAULT_BEAN_VALIDATOR</param-name>
        <param-value>false</param-value>
    </context-param>
    <servlet>
        <servlet-name>FacesServlet</servlet-name>
        <servlet-class>javax.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
        <multipart-config>
            <max-file-size>27262976</max-file-size>
            <max-request-size>28311552</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>FacesServlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>
    <filter>
        <filter-name>AcessoFilter</filter-name>
        <filter-class>br.com.hobbyhub.jsf.config.AcessoFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AcessoFilter</filter-name>
        <url-pattern>/visualizar-posts/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AcessoFilter</filter-name>
        <url-pattern>/postar/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AcessoFilter</filter-name>
        <url-pattern>/midias/*</url-pattern>
    </filter-mapping>
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <name>HOBBYHUB_JSF</name>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>
    <welcome-file-list>
        <welcome-file>visualizar-posts/feed.xhtml</welcome-file>
    </welcome-file-list>
</web-app>
